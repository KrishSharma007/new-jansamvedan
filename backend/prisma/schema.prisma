// Datasource
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generator
generator client {
  provider = "prisma-client-js"
}

// Models
model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  passwordHash      String
  phone             String?
  address           String?
  role              String                   @default("CITIZEN") // CITIZEN, ADMIN, NGO
  ngoStatus         String                   @default("VERIFIED") // VERIFIED, PENDING, REJECTED
  
  // Role-specific fields
  department        String?                  // For ADMIN users
  organization      String?                  // For NGO users
  serviceArea       String?                  // For NGO users
  
  complaints        Complaint[]
  helpingWith       ComplaintHelper[]
  confirmations     ComplaintConfirmation[]
  statusChangesMade ComplaintStatusHistory[]
  notifications     Notification[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model Complaint {
  id                 String                  @id @default(cuid())
  complaintId        String                  @unique // human-readable identifier like CR2024XXXX
  title              String
  description        String
  category           String
  priority           String
  confirmationsCount Int                     @default(0)
  status             String                  @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, RESOLVED, REJECTED
  latitude           Float?
  longitude          Float?
  address            String?
  imageUrl           String?
  isAnonymous        Boolean                 @default(false)
  mergedIntoId       String?                 // If this complaint was merged into a master
  mergedInto         Complaint?              @relation("MergedComplaints", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom         Complaint[]             @relation("MergedComplaints")
  reportedBy         User                    @relation(fields: [reportedById], references: [id])
  reportedById       String
  assignedDept       String?
  helpers            ComplaintHelper[]
  confirmations      ComplaintConfirmation[]
  statusHistory      ComplaintStatusHistory[]
  notifications      Notification[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([category])
  @@index([reportedById])
  @@index([mergedIntoId])
}

// Track citizen confirmations/upvotes for duplicate or existing complaints
model ComplaintConfirmation {
  id          String    @id @default(cuid())
  complaintId String
  userId      String
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([complaintId, userId]) // Prevent duplicate confirms by same user
  @@index([complaintId])
  @@index([userId])
}

// Track status change audit log for accountability
model ComplaintStatusHistory {
  id            String    @id @default(cuid())
  complaintId   String
  oldStatus     String?
  newStatus     String
  changedById   String
  changedByRole String
  notes         String?
  createdAt     DateTime  @default(now())

  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy     User      @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([changedById])
}

// User Notification log
model Notification {
  id          String    @id @default(cuid())
  userId      String
  complaintId String?
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Track which NGOs/Volunteers are helping with which complaints
model ComplaintHelper {
  id            String        @id @default(cuid())
  complaintId   String
  userId        String        // Reference to User table
  status        String        @default("HELPING") // HELPING, CONTACTED, DECLINED
  message       String?       // Optional message from NGO
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  complaint     Complaint     @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([complaintId, userId]) // Prevent duplicate helpers
  @@index([complaintId])
  @@index([userId])
}